# ServiceFlow Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Example local: mongodb://127.0.0.1:27017/serviceflow
# Leave empty to automatically start built-in in-memory MongoDB for local dev & evaluation
MONGODB_URI=mongodb://127.0.0.1:27017/serviceflow

# JWT Secret Key
JWT_SECRET=serviceflow_enterprise_super_secret_jwt_key_2026_production_grade

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
